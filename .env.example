# Copy this file to .env.local for local development, or set these in the
# Vercel dashboard under Project Settings -> Environment Variables.
# Never commit the real values.

# Password that gates: the Finances page, publishing/editing on Blogs,
# Quotes, and Dad Jokes, and any blog post marked "restricted".
SITE_PASSWORD=

# Neon Postgres connection string. Provisioned via Vercel's Storage tab
# (Marketplace -> Neon). Named with a DNP_ prefix because the integration's
# env vars were renamed after connecting it to this project.
DNP_DATABASE_URL=
